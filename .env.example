# ========================================================
# 404 FOUNDERS - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in your credentials
# ========================================================

# Supabase Configuration (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth Credentials (configured in Supabase Auth & Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Resend SMTP Configuration (Free Tier - 3000 emails/month)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key
SMTP_FROM=onboarding@resend.dev
SMTP_FROM_NAME=404 Founders Messenger

# Cloudflare Turnstile Bot Protection (Free Tier)
# Use 1x00000000000000000000AA for testing site key
# Use 1x0000000000000000000000000000000AA for testing secret key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Giphy / Tenor Free API Key (falls back to local uploads if omitted)
GIF_API_KEY=
